{
  "name": "@re-tree/api",
  "version": "0.1.0",
  "private": true,
  "description": "Hono API for Re-Tree (Node locally, Cloudflare Worker in production)",
  "main": "src/server.ts",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:worker": "wrangler dev",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "migrate:deploy": "drizzle-kit migrate",
    "db:bootstrap": "drizzle-kit push && tsx src/db/seed.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@hono/node-server": "^1.8.0",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^1.0.2",
    "@hono/zod-validator": "^0.7.3",
    "@neondatabase/serverless": "^1.0.2",
    "bcryptjs": "^3.0.2",
    "drizzle-orm": "^0.44.5",
    "hono": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.5",
    "postgres": "^3.4.7",
    "stripe": "^14.0.0",
    "zod": "^4.0.10"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^6.4.17",
    "dotenv": "^16.4.7",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "wrangler": "^4.126.0"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
