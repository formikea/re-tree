# apps/api — copy to `.env` for local Node, or `.dev.vars` for `wrangler dev`.
#
# Host Node + Compose Postgres:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/re_tree_db"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/re_tree_db"

# Server (local Node only; Workers ignore PORT)
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
REFRESH_TOKEN_SECRET=your-super-secret-refresh-token-key-change-in-production
INVITATION_SECRET=your-invitation-secret-change-in-production

# Email — prefer Resend (works on Cloudflare Workers).
# RESEND_API_KEY=re_xxxxxxxx
# SMTP_FROM=hello@re-tree.app
# SMTP_FROM_NAME=Re-Tree
#
# Optional SMTP fallback for local Node only:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
RESET_PASSWORD_SECRET=change-me

# SPA origin for invite / password-reset links
FRONTEND_URL=http://localhost:3000

# Stripe (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
