# Development image for compose api/client/website services (Hono + Vite).
# Built from the repo root so npm workspaces resolve correctly.
# Source is bind-mounted at runtime; node_modules uses a named volume.

FROM node:22-bookworm-slim

WORKDIR /workspaces/re-tree

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

COPY package.json package-lock.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/client/package.json apps/client/package.json
COPY apps/website/package.json apps/website/package.json
# postinstall (api) runs prisma generate — needs schema + scripts before npm ci
COPY apps/api/prisma apps/api/prisma
COPY apps/api/prisma.config.ts apps/api/prisma.config.ts
ENV DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/re_tree_db"
RUN npm ci --no-audit --no-fund

EXPOSE 5000 3000 3001
