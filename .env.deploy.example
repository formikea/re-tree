# Neon (production) — Worker secret DATABASE_URL (HTTP driver; neon.tech URL).
# Get with: neon connection-string --project-id <your-neon-project-id> --pooled
# DATABASE_URL=

# Cloudflare account
# CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>

# Neon project
# NEON_PROJECT_ID=<your-neon-project-id>
